[Unit]
Description=Trainer: coach weekly report for the week that just closed

[Timer]
# VPS живёт в Europe/Moscow — полночь с воскресенья на понедельник: неделя
# закончилась по-настоящему, и воскресная вечерняя сессия попадает в свой же
# отчёт. В понедельник утром атлет находит баннер готовым. Persistent=true
# догоняет пропуск после простоя VPS.
OnCalendar=Mon *-*-* 00:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
