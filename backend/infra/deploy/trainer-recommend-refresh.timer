[Unit]
Description=Trainer: morning refresh of the coach recommendation

[Timer]
# VPS живёт в Europe/Moscow — 06:30 по местному, чтобы карточка встречала атлета
# планом с сегодняшней датой. Persistent=true догоняет пропуск после простоя VPS.
OnCalendar=*-*-* 06:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
